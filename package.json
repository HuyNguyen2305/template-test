{
  "name": "template-test",
  "version": "1.0.0",
  "private": true,
  "description": "A Node.js project",
  "type": "module",
  "imports": {
    "#configs/*": "./src/configs/*",
    "#common/*": "./src/common/*",
    "#constants/*": "./src/common/constants/*",
    "#repositories/*": "./src/repositories/*",
    "#services/*": "./src/services/*",
    "#controllers/*": "./src/controllers/*",
    "#routers/*": "./src/routers/*",
    "#schemas/*": "./src/schemas/*",
    "#models/*": "./src/models/*"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/integration",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "sequelize-cli db:migrate --config config/config.cjs --migrations-path migrations --models-path src/models",
    "migrate:undo": "sequelize-cli db:migrate:undo --config config/config.cjs --migrations-path migrations --models-path src/models"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/awilix": "^8.2.1",
    "@fastify/request-context": "^7.0.0",
    "awilix": "^13.0.5",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "sequelize-cli": "^6.6.5"
  }
}
